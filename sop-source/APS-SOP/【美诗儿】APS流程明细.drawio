"><mxGeometry x="371" y="386" width="42" height="11" as="geometry" /></mxCell><mxCell id="p4_role" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:10px;font-family:Microsoft YaHei;color:#ffffff;direction:ltr;line-height:130%;opacity:1&quot;&gt;计划&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;overflow=width;fillColor=#6759e6;strokeColor=#000000;shadow=1;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="371" y="421" width="42" height="11" as="geometry" /></mxCell><mxCell id="dia" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:10px;font-family:Microsoft YaHei;color:#000000;direction:ltr;line-height:130%;opacity:1&quot;&gt;评估是否调整需求？&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;overflow=width;fillColor=#f0f0f0;gradientColor=#f0f0f0;gradientDirection=north;strokeColor=#000000;shadow=1;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="283" y="444" width="130" height="46" as="geometry" /></mxCell><mxCell id="p5" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:10px;font-family:Microsoft YaHei;color:#000000;direction:ltr;line-height:130%;opacity:1&quot;&gt;供需是否平衡&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;overflow=width;fillColor=#f0f0f0;gradientColor=#f0f0f0;gradientDirection=north;strokeColor=#000000;shadow=1;shape=rhombus;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="283" y="504" width="130" height="46" as="geometry" /></mxCell><mxCell id="end" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:10px;font-family:Microsoft YaHei;color:#000000;direction:ltr;line-height:130%;opacity:1&quot;&gt;结束&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;overflow=width;fillColor=#f0f0f0;gradientColor=#f0f0f0;gradientDirection=north;strokeColor=#000000;shadow=1;rounded=1;arcSize=50;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="303" y="758" width="90" height="36" as="geometry" /></mxCell><mxCell id="tY" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:11px;font-family:Microsoft YaHei;color:#000000;direction:ltr;line-height:130%;opacity:1&quot;&gt;是&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="444" y="450" width="26" height="20" as="geometry" /></mxCell><mxCell id="tN" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:11px;font-family:Microsoft YaHei;color:#000000;direction:ltr;line-height:130%;opacity:1&quot;&gt;否&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;fillColor=none;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="352" y="490" width="26" height="20" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="p2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="467" /><mxPoint x="240" y="293" /></Array></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="dia"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia" target="p2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="467" /><mxPoint x="440" y="302" /></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bd_note" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:12px;font-family:Microsoft YaHei;color:#000000;line-height:150%;opacity:1&quot;&gt;&lt;b&gt;场景：&lt;/b&gt;每月由业务在 E10 维护销售预测、销售订单与成品安全库存；计划在 APS 汇整需求并执行物料规划，检视订单达交与供需平衡后确认生产、采购计划，并回抛 E10 下发。&lt;br&gt;1. 需求维护：业务在 E10 维护销售预测（预估下一生产周期销售量）、销售订单（客户实际需求）与成品安全库存（撇除预测及订单外应预留的库存）。&lt;br&gt;2. 汇整与规划：打开 APS 选定规划版本 MSE-MCP，汇整 MDS 需求（MDS007）并新建 APS 储存版本，在 MDS 汇整结果维护作业（MDS009）按冲销后订单优先权排序（可人工调整）后执行【物料规划】。&lt;br&gt;3. 检视：以订单交期总表（RPT007）结合现有物料供给与制造加工周期推算订单交货日；以品项需求明细表（MRP109）检视需求—供给配置是否平衡。&lt;br&gt;4. 需调整需求时：由计划协调业务调整未完工订单的需求日期或需求数量，放弃本版本结果，回到「汇整需求」重新规划。&lt;br&gt;5. 回抛与下发：批次勾选变更作业（CPT019，不勾选则全部回抛）回抛新开工单（RPT010）、新开采购令（RPT011）；版本确认后资料即锁定，计划、采购在 E10 发放生产计划、采购计划并转成正式工单、请采购单。&lt;br&gt;6. 供需不平衡时：&lt;br&gt;&amp;nbsp;&amp;nbsp;① 物料缺口：APS 新开工单、新开请采购单，计划、采购校验后推送 E10 维护生产、采购计划并发放，生成正式工单、请采购单&lt;br&gt;&amp;nbsp;&amp;nbsp;② 物料多余：计划、采购参考 APS 建议，手动调整已开工单、已开请采购单数量 / 日期形成取消清单，E10 维护工单变更单、采购单变更&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#FF0000&quot;&gt;变更后务必重跑 APS，同步最新数据再排程。&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=width;spacingLeft=2;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1072" y="276" width="430" height="380" as="geometry" /></mxCell><mxCell id="lg_sep" style="endArrow=none;strokeColor=#404040;strokeWidth=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1063" y="658" as="sourcePoint" /><mxPoint x="1511" y="658" as="targetPoint" /></mxGeometry></mxCell><mxCell id="lg_title" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:14px;font-family:Microsoft YaHei;color:#000000;font-weight:bold;direction:ltr;line-height:130%;opacity:1&quot;&gt;标准图例&lt;/font&gt;&lt;/div&gt;" style="text;html=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1241" y="672" width="111" height="24" as="geometry" /></mxCell><mxCell id="lg_694_708" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:10px;font-family:Microsoft YaHei;color:#000000;direction:ltr;line-height:130%;opacity:1&quot;&gt;开始/结束&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;overflow=width;fillColor=#f0f0f0;gradientColor=#f0f0f0;gradientDirection=north;strokeColor=#000000;shadow=1;rounded=1;arcSize=50;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1068" y="714" width="67" height="24" as="geometry" /></mxCell><mxCell id="lg_694_784" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:10px;font-family:Microsoft YaHei;color:#000000;direction:ltr;line-height:130%;opacity:1&quot;&gt;作业&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;overflow=width;fillColor=#f0f0f0;gradientColor=#f0f0f0;gradientDirection=north;strokeColor=#000000;shadow=1;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1144" y="714" width="53" height="27" as="geometry" /></mxCell><mxCell id="lg_694_848" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:10px;font-family:Microsoft YaHei;color:#000000;direction:ltr;line-height:130%;opacity:1&quot;&gt;表单&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;overflow=width;fillColor=#f0f0f0;gradientColor=#f0f0f0;gradientDirection=north;strokeColor=#000000;shadow=1;shape=document;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1208" y="714" width="53" height="27" as="geometry" /></mxCell><mx