"1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="610"/><mxPoint x="110" y="409"/></Array></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="683"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bd_note" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:12px;font-family:Microsoft YaHei;color:#000000;line-height:170%;opacity:1&quot;&gt;&lt;b&gt;场景：&lt;/b&gt;每天由计划在 APS 基于现有资源产能制定未来 N 天生产工单排产计划，调整设备与模具资源、检视每日生产计划并跟催物料，版本确认后推送 MES 与 WMS。&lt;br&gt;&lt;br&gt;1. 排程准备：打开 APS 选定规划版本 MSE-APS1，汇整 MDS 需求（MDS007）并新建 APS 储存版本，在 MDS 汇整结果维护作业（MDS009）执行【物料产能规划】。&lt;br&gt;2. 资源安排：维护机台（DAT030）、日行事历（DAT029）、周行事历（DAT054）、加班保修（DAT088）与模具保修（DAT051），线下收集、系统录入，覆盖未来 1-3 天设备与模具资源安排。&lt;br&gt;3. 计划检视：以每日生产计划（RPT032）检视生产安排合理性、物料齐套与模具满足状况；需调整时通过手调界面（调整工序计划 CPT027）调整未来一周工单生产顺序与所用机台，如有调整必须重排。&lt;br&gt;4. 物料跟催：计划、采购依工单物料短缺表（RPT092）共同跟催未来 1-7 天物料。&lt;br&gt;5. 版本确认后推送排产计划至 MES（派工依据）、物料需求计划至 WMS（送料依据），详见 MSE014、MSE015 流程。&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=width;spacingLeft=2;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="712" y="276" width="430" height="350" as="geometry"/></mxCell><mxCell id="lg_sep" style="endArrow=none;strokeColor=#404040;strokeWidth=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="703" y="638" as="sourcePoint"/><mxPoint x="1151" y="638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_title" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:14px;font-family:Microsoft YaHei;color:#000000;font-weight:bold;direction:ltr;line-height:130%;opacity:1&quot;&gt;标准图例&lt;/font&gt;&lt;/div&gt;" style="text;html=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="881" y="652" width="111" height="24" as="geometry"/></mxCell><mxCell id="lg_694_708" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:10px;font-family:Microsoft YaHei;color:#000000;direction:ltr;line-height:130%;opacity:1&quot;&gt;开始/结束&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=middle;align=center;overflow=width;fillColor=#f0f0f0;gradientColor=#f0f0f0;gradientDirection=north;strokeColor=#000000;shadow=1;rounded=1;arcSize=50;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="708" y="694" width="67" height="24" as="geometry"/></mxCell><mxCell id="lg_694_784" value="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;font style=&quot;font-size:10px;font-family:Microsoft YaHei;color:#000000;direct