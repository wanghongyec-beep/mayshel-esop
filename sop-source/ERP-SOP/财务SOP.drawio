        <mxCell id="p6-c5gTP7q117IZUSJ7-knc-14" parent="p6-c5gTP7q117IZUSJ7-knc-12" style="verticalAlign=middle;align=center;overflow=width;vsdxID=13;fillColor=#f0f0f0;gradientColor=#ffffff;gradientDirection=north;shape=stencil(nZBLDoAgDERP0z3SIyjew0SURgSD+Lu9kMZoXLhwN9O+tukAlrNpJg1SzDH4QW/URgNYgZTkjA4UkwJUgGXng+6DX1zLfmoymdXo17xh5zmRJ6Q42BWCfc2oJfdAr+Yv+AP9Cb7OJ3H/2JG1HNGz/84klThPVCc=);strokeColor=#404040;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;connectable=0;" value="&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;font style=&quot;font-size:14.11px;font-family:Microsoft YaHei;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;关键作业说明&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="448" as="geometry" />
        </mxCell>
        <UserObject label="" tags="背景" id="p6-c5gTP7q117IZUSJ7-knc-15">
          <mxCell parent="p6-c5gTP7q117IZUSJ7-knc-1" style="vsdxID=14;fillColor=#f0f0f0;gradientColor=#ffffff;gradientDirection=north;shape=stencil(nZBLDoAgDERP0z3SIyDew0QUooJB/N1eSGM0LFywm2lf23QAxarbRQFna/BuVIfpggasgXNjtfImRAUoAUXvvBq822xHfmkTmdTs9rThpDmWJji7yFWMfEPoZOwHfZpF8A9aCGbno3h/jCYPIJYoPJQ3);strokeColor=#404040;shadow=1;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="532" width="1110" x="40" y="268" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(0, 0, 0); line-height: 140%;&quot;&gt;场景：非采购挂应付账款的业务，如固定资产、运费等等。&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(0, 0, 0); line-height: 140%;&quot;&gt;1、单据录入：需求部门把实物发票及相关手续给到应付会计，应付会计于【维护费用应付单】作业中把费用信息以及实物发票号码录入系统，单头业务类型为正向；&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(0, 0, 0); line-height: 140%;&quot;&gt;2、单据审核：应付会计接收到实物发票进系统根据发票号码查询到应付单，核对总金额、税额是否正确，确认修改后进行审核以及会计凭证抛转；&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(0, 0, 0); line-height: 140%;&quot;&gt;3、报表查询：可查询《应付账款余额表》。&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(0, 0, 0); line-height: 140%;&quot;&gt;作业路径：应付管理-&gt;应付立账-&gt;维护费用应付单&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(192, 0, 0); line-height: 140%;&quot;&gt;注意：如开立为红字发票，则单头业务类型选择为负向。&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" tags="背景" id="p6-c5gTP7q117IZUSJ7-knc-19">
          <mxCell parent="p6-c5gTP7q117IZUSJ7-knc-1" style="verticalAlign=middle;align=left;overflow=width;vsdxID=20;fillColor=none;gradientColor=none;shape=stencil(nZBLDoAgDERP0z3SIyjew0SURgSD+Lu9kMZoXLhwN9O+tukAlrNpJg1SzDH4QW/URgNYgZTkjA4UkwJUgGXng+6DX1zLfmoymdXo17xh5zmRJ6Q42BWCfc2oJfdAr+Yv+AP9Cb7OJ3H/2JG1HNGz/84klThPVCc=);strokeColor=none;spacingTop=-1;spacingBottom=-1;spacingLeft=-1;spacingRight=-1;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1">
