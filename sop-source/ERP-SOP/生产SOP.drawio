        </mxCell>
        <UserObject label="" tags="背景" id="p3-c5gTP7q117IZUSJ7-knc-15">
          <mxCell parent="p3-c5gTP7q117IZUSJ7-knc-1" style="vsdxID=14;fillColor=#f0f0f0;gradientColor=#ffffff;gradientDirection=north;shape=stencil(nZBLDoAgDERP0z3SIyDew0QUooJB/N1eSGM0LFywm2lf23QAxarbRQFna/BuVIfpggasgXNjtfImRAUoAUXvvBq822xHfmkTmdTs9rThpDmWJji7yFWMfEPoZOwHfZpF8A9aCGbno3h/jCYPIJYoPJQ3);strokeColor=#404040;shadow=1;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="532" width="1110" x="40" y="268" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:1px&quot;&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(0, 0, 0); line-height: 140%;&quot;&gt;场景：工单生产完成后按实际消耗扣减材料库存。&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(0, 0, 0); line-height: 140%;&quot;&gt;1、需求来源：根据工单所需执行领料；&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(0, 0, 0); line-height: 140%;&quot;&gt;2、MES 报工：车间生产完成后在 MES 报工，把物料消耗清单传给 WMS；&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(0, 0, 0); line-height: 140%;&quot;&gt;3、单据生成：WMS 根据工单消耗明细扣除材料库存，并把结果推送给 ERP 生成领料出库单；&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(0, 0, 0); line-height: 140%;&quot;&gt;4、报表查询：可查询【领退料明细查询】。&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(0, 0, 0); line-height: 140%;&quot;&gt;作业路径：工单管理-&gt;工单发料-&gt;维护领料出库单&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;text-align:left;margin:4px 0 0 0;text-indent:0;vertical-align:middle;direction:ltr&quot;&gt;&lt;font style=&quot;font-size: 12px; font-family: &amp;quot;Microsoft YaHei&amp;quot;; color: rgb(192, 0, 0); line-height: 140%;&quot;&gt;注意：ERP 端不做手工领料录入，全部由 WMS 推送生成，切勿重复录单。&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" tags="背景" id="p3-c5gTP7q117IZUSJ7-knc-19">
          <mxCell parent="p3-c5gTP7q117IZUSJ7-knc-1" style="verticalAlign=middle;align=left;overflow=width;vsdxID=20;fillColor=none;gradientColor=none;shape=stencil(nZBLDoAgDERP0z3SIyjew0SURgSD+Lu9kMZoXLhwN9O+tukAlrNpJg1SzDH4QW/URgNYgZTkjA4UkwJUgGXng+6DX1zLfmoymdXo17xh5zmRJ6Q42BWCfc2oJfdAr+Yv+AP9Cb7OJ3H/2JG1HNGz/84klThPVCc=);strokeColor=none;spacingTop=-1;spacingBottom=-1;spacingLeft=-1;spacingRight=-1;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1">
