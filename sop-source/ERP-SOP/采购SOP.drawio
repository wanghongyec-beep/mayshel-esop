        <UserObject label="" tags="背景" id="p1-c5gTP7q117IZUSJ7-knc-15">
          <mxCell parent="p1-c5gTP7q117IZUSJ7-knc-1" style="vsdxID=14;fillColor=#f0f0f0;gradientColor=#ffffff;gradientDirection=north;shape=stencil(nZBLDoAgDERP0z3SIyDew0QUooJB/N1eSGM0LFywm2lf23QAxarbRQFna/BuVIfpggasgXNjtfImRAUoAUXvvBq822xHfmkTmdTs9rThpDmWJji7yFWMfEPoZOwHfZpF8A9aCGbno3h/jCYPIJYoPJQ3);strokeColor=#404040;shadow=1;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1">
